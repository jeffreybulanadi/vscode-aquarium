{
  "name": "vscode-aquarium",
  "displayName": "VSCode Aquarium",
  "description": "A relaxing animated aquarium with fish that live inside your VS Code editor.",
  "version": "0.1.0",
  "publisher": "learnbeyondbc",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "aquarium.open",
        "title": "Aquarium: Open Aquarium"
      },
      {
        "command": "aquarium.addFish",
        "title": "Aquarium: Add Fish"
      },
      {
        "command": "aquarium.removeAllFish",
        "title": "Aquarium: Remove All Fish"
      },
      {
        "command": "aquarium.feed",
        "title": "Aquarium: Feed Fish"
      },
      {
        "command": "aquarium.switchType",
        "title": "Aquarium: Switch Aquarium Type (Fresh/Salt)"
      }
    ],
    "configuration": {
      "title": "Aquarium",
      "properties": {
        "aquarium.type": {
          "type": "string",
          "enum": [
            "freshwater",
            "saltwater"
          ],
          "default": "freshwater",
          "description": "Type of aquarium to display."
        },
        "aquarium.fish": {
          "type": "array",
          "default": [
            {
              "species": "arowana"
            },
            {
              "species": "oscar"
            }
          ],
          "description": "Fish currently living in the aquarium."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.3.0"
  }
}
